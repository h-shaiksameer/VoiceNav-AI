APP_NAME=VoiceNav AI

OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter

# Set META_ENABLED=on when using a first-party Meta Model API key.
META_ENABLED=off
META_API_KEY=
META_MODEL=muse-spark-open
META_API_BASE_URL=https://api.llama.com/v1

# The local deterministic engine is always available as the final fallback.
# Set GEMINI_ENABLED=on for normal optional model classification.
GEMINI_ENABLED=on
GEMINI_API_KEY=

# Set BASETEN_ENABLED=on only when demonstrating Meta Muse Spark Open.
BASETEN_ENABLED=off
BASETEN_API_KEY=
# Baseten Model API slug. Keep the default for the Meta AI hackathon model.
BASETEN_MODEL=meta-models/muse-spark-open


MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png