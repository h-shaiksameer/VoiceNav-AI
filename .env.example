APP_NAME=VoiceNav AI

OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter

# Server-only local Meta MMS speech-to-text service. Keep disabled by default.
META_MMS_ENABLED=false
META_MMS_SERVICE_URL=http://127.0.0.1:8001
META_MMS_MODEL_ID=facebook/mms-1b-all
META_MMS_MODEL_PATH=
META_MMS_DEVICE=cpu
META_MMS_LANGUAGE=eng
META_MMS_MAX_AUDIO_BYTES=15728640
META_MMS_MAX_AUDIO_SECONDS=90
META_MMS_REQUEST_TIMEOUT_MS=120000

# Set META_ENABLED=on when using a first-party Meta Model API key.
META_ENABLED=off
META_API_KEY=
META_MODEL=muse-spark-open-1026
META_API_BASE_URL=https://api.llama.com/v1

# Set on for the Meta Global AI Developer Hackathon runtime.
# This prevents Gemini or other non-Meta intent models from being selected.
META_HACKATHON_MODE=off

# The local deterministic engine is always available as the final fallback.
# Set GEMINI_ENABLED=on for normal optional model classification.
GEMINI_ENABLED=on
GEMINI_API_KEY=

# Set BASETEN_ENABLED=on only when demonstrating Meta Muse Spark Open.
BASETEN_ENABLED=off
BASETEN_API_KEY=
# Baseten Model API slug. Keep the default for the Meta AI hackathon model.
BASETEN_MODEL=meta-models/muse-spark-open-1026


MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png